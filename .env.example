# Copy this file to .env and fill in the key for the provider you use.

# Which AI to use: "claude" (default) or "gemini"
AI_PROVIDER=claude

# Claude: get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

# Gemini: get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest   # used when the main model is overloaded

# Optional
# PORT=3000
# APP_PASSWORD=choose-a-shared-password   # if set, visitors must enter it before using the app
# GENERATIONS_PER_HOUR=5                  # per-visitor limit on generations
